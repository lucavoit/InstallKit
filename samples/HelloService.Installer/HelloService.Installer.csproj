<Project>
  <!--
    Inside this repo the sample imports the SDK from source. In your own repo this whole header is just:
      <Project Sdk="InstallKit.Sdk/0.1.0">
  -->
  <PropertyGroup>
    <InstallKitUseProjectReferences>true</InstallKitUseProjectReferences>
  </PropertyGroup>
  <Import Project="..\..\src\InstallKit.Sdk\Sdk\Sdk.props" />

  <ItemGroup>
    <!-- Published self-contained, so the target machine needs no .NET runtime. -->
    <InstallerPayload Include="..\HelloService\HelloService.csproj"
                      PublishProperties="RuntimeIdentifier=win-x64;SelfContained=true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\InstallKit.WixSharp\InstallKit.WixSharp.csproj" />
    <!-- In this repo the generator comes from source; the InstallKit.Abstractions package ships it automatically. -->
    <ProjectReference Include="..\..\src\InstallKit.Generators\InstallKit.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Import Project="..\..\src\InstallKit.Sdk\Sdk\Sdk.targets" />
</Project>
