<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Tests the real engine: the model goes through the same mapping to WixSharp as in a build, and the tests read the
    WiX source that comes out. WiX itself does not run, so this works on any machine.

    Both engines compile the same source files, so those files are compiled into this project, against the
    WixSharp package. The INSTALLKIT_CORE symbol leaves out the WPF dialogs, which need a Windows desktop.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>InstallKit.WixSharp.Engine.Tests</RootNamespace>
    <DefineConstants>$(DefineConstants);INSTALLKIT_CORE</DefineConstants>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- The engine files are written for the engines, which only annotate nullability; WixSharp is not annotated. -->
    <Nullable>annotations</Nullable>
    <!-- WixSharp_wix4 is a .NET Framework package; its managed code runs fine on .NET. -->
    <NoWarn>$(NoWarn);NU1701;CA1416;xUnit1031</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="WixSharp_wix4" Version="2.14.2" />
    <PackageReference Include="WixToolset.Dtf.WindowsInstaller" Version="4.0.1" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\InstallKit.Abstractions\InstallKit.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\src\InstallKit.WixSharp\WixSharpEngine.cs" Link="Engine\WixSharpEngine.cs" />
    <Compile Include="..\..\src\InstallKit.WixSharp\BrandingImages.cs" Link="Engine\BrandingImages.cs" />
    <Compile Include="..\..\src\InstallKit.WixSharp\WixSharpCustomizations.cs" Link="Engine\WixSharpCustomizations.cs" />
    <Compile Include="..\..\src\InstallKit.WixSharp\ModernDialogs.cs" Link="Engine\ModernDialogs.cs" />
    <Compile Include="..\..\src\InstallKit.WixSharp\ModernDialogXml.cs" Link="Engine\ModernDialogXml.cs" />
    <Compile Include="..\..\src\InstallKit.WixSharp\StockDialogXml.cs" Link="Engine\StockDialogXml.cs" />
    <Compile Include="..\..\src\InstallKit.WixSharp\Palette.cs" Link="Engine\Palette.cs" />
    <Compile Include="..\..\src\InstallKit.WixSharp\BundleTheme.cs" Link="Engine\BundleTheme.cs" />
    <Compile Include="..\..\src\InstallKit.WixSharp\IdentifierLimits.cs" Link="Engine\IdentifierLimits.cs" />
  </ItemGroup>
</Project>
