<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Tests the XML of the modern dialogs. The builder uses no WixSharp types, so its source file is compiled
    straight into this project and the tests run anywhere, without a Windows engine.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- The builder file is written for the engines, which only annotate nullability. -->
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\src\InstallKit.WixSharp\ModernDialogXml.cs" Link="ModernDialogXml.cs" />
    <Compile Include="..\..\src\InstallKit.WixSharp\Palette.cs" Link="Palette.cs" />
    <Compile Include="..\..\src\InstallKit.WixSharp\BundleTheme.cs" Link="BundleTheme.cs" />
    <Compile Include="..\..\src\InstallKit.WixSharp\IdentifierLimits.cs" Link="IdentifierLimits.cs" />
  </ItemGroup>
</Project>
