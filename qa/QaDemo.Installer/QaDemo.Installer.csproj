<Project>
  <!-- QA demo installer, WixSharp engine. Imports the SDK from source like the samples. -->
  <PropertyGroup>
    <InstallKitUseProjectReferences>true</InstallKitUseProjectReferences>
  </PropertyGroup>
  <Import Project="..\..\src\InstallKit.Sdk\Sdk\Sdk.props" />

  <ItemGroup>
    <InstallerPayload Include="..\QaDemo\QaDemo.csproj"
                      PublishProperties="RuntimeIdentifier=win-x64;SelfContained=true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\InstallKit.WixSharp\InstallKit.WixSharp.csproj" />
    <ProjectReference Include="..\..\src\InstallKit.Generators\InstallKit.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Import Project="..\..\src\InstallKit.Sdk\Sdk\Sdk.targets" />
</Project>
