<Project Sdk="Microsoft.NET.Sdk">
  <!-- dotnet new templates: dotnet new install InstallKit.Templates; dotnet new installkit -n MyApp.Installer -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <PackageType>Template</PackageType>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeContentInPack>true</IncludeContentInPack>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <Description>dotnet new templates for InstallKit installer projects.</Description>
    <EnableDefaultItems>false</EnableDefaultItems>
    <PackageTags>dotnet-new;templates;installer;msi;wix;wixsharp;windows</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="content\**" Exclude="content\**\bin\**;content\**\obj\**" />
  </ItemGroup>
</Project>
